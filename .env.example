# ── App version ──────────────────────────────────────────────────────────────
# Displayed in the app header. Update when deploying a new version.
# APP_VERSION is defined in frontend/src/version.ts (not an env var at runtime)

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Sheet ID from the spreadsheet URL: /spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=your_google_sheet_id_here

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=192.168.0.167
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=kapoortraders

# ── Google Service Account (optional) ────────────────────────────────────────
# Required ONLY to enable DB → Sheet sync (writing back to Google Sheets).
# Paste the full service account JSON as a single-line string.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── OpenAI (optional) ─────────────────────────────────────────────────────────
# Required for the AI Chat assistant tab.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini   (default — change to gpt-4o for better answers)

# ── Cash cycle start day (optional) ──────────────────────────────────────────
# Day of month when the cash cycle begins. Used for default date range in Cash tab.
# Must be between 1 and 28. Defaults to 23.
# VITE_CASH_START_DAY=23

# ── Google Drive Backup / Restore (optional) ─────────────────────────────────
# Required for the Backup to Drive / Restore from Drive feature in the Status tab.
# Create an OAuth 2.0 client ID at https://console.cloud.google.com/apis/credentials
# Enable the Google Drive API and Google Picker API.
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# VITE_GOOGLE_API_KEY=your-api-key
